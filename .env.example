# Optional: local development already falls back to http://localhost:8080/deutsch-hub
# Example of a public production build variable; requires a real same-origin reverse proxy.
# VITE_API_BASE_URL=/deutsch-hub

# Alternative for an HTTPS backend hosted separately:
# VITE_API_BASE_URL=https://api.example.org/deutsch-hub

# Do not add secrets in VITE_* variables. They become public browser bundle data.
